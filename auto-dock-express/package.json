{
  "name": "auto-dock-express",
  "version": "1.0.8",
  "description": "",
  "main": "auto-dock.js",
  "scripts": {
    "rebuild": "del-cli --force dist && npm run build",
    "dev": "npm run kill-port && nodemon --watch 'src/**/*.ts' --exec 'npm run kill-port && ts-node src/server.ts'",
    "build": "tsc",
    "build:arm64-image": "docker build -t playbox21/auto-dock-express_arm64:$npm_package_version --no-cache -f Dockerfile-arm64 .",
    "build:amd64-image": "docker build -t playbox21/auto-dock-express_amd64:$npm_package_version --platform linux/amd64 --no-cache -f Dockerfile-amd64 .",
    "start": "node dist/find-node.js",
    "kill-port": "node -e \"require('dotenv').config(); const port = process.env.PORT; if (!port) { console.error('PORT not defined in .env'); process.exit(1); } const { execSync } = require('child_process'); try { const pid = execSync('lsof -ti:' + port).toString().trim(); if (pid) { execSync('kill -9 ' + pid); console.log('Killed process ' + pid + ' on port ' + port); } else { console.log('No process found on port ' + port); } } catch (err) { console.log('No process found on port ' + port); }\"",
    "test": "jest --coverage",
    "test:watch": "jest --watch && npm run build:watch"
  },
  "author": "ljeff@us.ibm.com",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@aws-sdk/client-bedrock-runtime": "^3.490.0",
    "@modelcontextprotocol/sdk": "^1.17.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-fileupload": "^1.2.1",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "jsonfile": "^6.1.0",
    "log4js": "^6.9.1",
    "morgan": "^1.10.0",
    "openai": "^4.20.1",
    "rxjs": "^7.8.2",
    "winston": "^3.11.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^29.2.1",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.2",
    "jest": "^29.2.2",
    "nodemon": "^3.1.10",
    "ts-jest": "^29.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
